__pycache__/
*.py[cod]
.venv/
venv/
.env
.DS_Store
.ipynb_checkpoints/

# scratch goal files written by notebooks (e.g. m1 smoke test)
datasets/_*.jsonl

# frozen harmful set + the raw AdvBench download — public repo; regenerate with
#   python datasets/build_harmful.py
datasets/harmful_behaviors.jsonl
datasets/advBench/*
!datasets/advBench/README.md

# per-machine config overrides
config.local.toml

# downloaded weights / caches
models/
*.safetensors
*.gguf
.hf_cache/

# run transcripts: keep the folder + its README, ignore the runs themselves.
# For the final evaluation pass, force-add the run dir as report evidence:
#   git add -f logs/<run-id>
logs/*
!logs/.gitkeep
!logs/README.md
